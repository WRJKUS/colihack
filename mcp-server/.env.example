# e-invoice.be API
EINVOICE_API_KEY=your_einvoice_api_key_here

# Your sandbox company PEPPOL details (sender)
SENDER_PEPPOL_SCHEME=0208
SENDER_PEPPOL_ID=your_peppol_id_here
SELLER_NAME=Your Company Name
SELLER_VAT=BE0XXXXXXXXX
SELLER_IBAN=BE00000000000000
SELLER_ADDRESS=Your Street 1, 1000 Brussels

# MCP server auth — must match what Bassel registers in Ingram Cloud
MCP_AUTH_SECRET=generate_a_random_32char_string_here
